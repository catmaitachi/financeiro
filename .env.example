# Alternativa de desenvolvimento ao cofre do sistema.
# O caminho recomendado é cadastrar as credenciais pela tela /setup,
# que as guarda no cofre. Se usar este arquivo, copie para .env
# (que está fora do Git) e nunca compartilhe os valores.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Opcionais
# FINANCEIRO_PORT=8787
# FINANCEIRO_DB_PATH=data/financeiro.db
